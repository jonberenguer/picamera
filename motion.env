# Tracked defaults. Anything specific to one machine — NFS server and export,
# camera name, credentials — belongs in motion.env.local instead, which is
# gitignored and overrides this file key by key. That way this file can be
# deployed freely without clobbering a configured install.

# Pan/tilt HAT:
#   auto — use the Pimoroni Pan-Tilt HAT if it answers on I2C, otherwise run as
#          a fixed camera (stream, zoom, snapshot, gallery all still work)
#   on   — the HAT is expected; log loudly if it does not respond
#   off  — fixed camera. Skips all I2C setup, and the installer will not ask for
#          a reboot to enable I2C.
PANTILT_ENABLED=auto

# Pan/tilt startup position (-90 to 90 degrees, 0 = center) — ignored without a HAT
PAN_START=55
TILT_START=80

# Basic auth — leave blank to disable (anyone on the network can access the UI)
AUTH_USER=picamera
AUTH_PASS=picamera

# Soft movement limits — camera will never move beyond these angles
# Useful when cables or mounting restrict the physical range
PAN_MIN=-90
PAN_MAX=90
TILT_MIN=-90
TILT_MAX=90

# Auto-scan sweep speed in radians/sec (0.4 ≈ 8s side-to-side, 0.2 ≈ 16s)
SCAN_SPEED=0.4

# How fast the camera travels to a saved preset or Home, in degrees/second.
# A servo sent straight to a new angle slews at full speed, and the jolt can
# shift the whole unit on a smooth surface. Lower is gentler:
#   20 ≈ very slow and deliberate, 45 ≈ default, 120 ≈ brisk, 0 = no easing
GOTO_SPEED=45

# ── NFS offload ────────────────────────────────────────────────────────────────
# Captures land in the tmpfs buffer (MOTION_TARGET_DIR) and are copied to the NFS
# share in the background, then deleted from the buffer. Leave NFS_ENABLED=false
# and captures simply stay in the buffer until it fills.
NFS_ENABLED=false
NFS_SERVER=
NFS_EXPORT=
NFS_MOUNT=/mnt/picam-nas
# Archive layout is <NFS_MOUNT>/<NFS_SUBDIR>/<CAMERA_NAME>/YYYY/MM/DD/
NFS_SUBDIR=picam
# Blank uses the Pi's hostname
CAMERA_NAME=
# 'soft' matters: a hard mount against a dead NAS parks processes in
# uninterruptible sleep and you cannot even restart the service.
NFS_MOUNT_OPTIONS=soft,timeo=50,retrans=3,noatime,nofail,_netdev

# Size of the tmpfs capture buffer. This is RAM — keep it well under the Pi's
# total, and remember that anything unarchived is lost on reboot.
BUFFER_TMPFS_SIZE=256M
# Percent full at which the oldest unarchived captures are discarded to keep
# the Pi alive. Logged as a warning and counted in /storage.
BUFFER_HIGH_WATER=80
# Seconds a file must be untouched before a sweep picks it up, so a movie still
# being written is never uploaded half-finished.
UPLOAD_STABLE_AGE=30
UPLOAD_SWEEP_INTERVAL=30
UPLOAD_RETRY_MIN=5
UPLOAD_RETRY_MAX=300
# Captures per gallery page. The UI pages with "Load more", so this is a page
# size, not a ceiling. Keep it modest: the grid loads full-size JPEGs, so a
# large page means megabytes of image per open.
GALLERY_LIMIT=50
# Most captures one delete or zip download may name at once
BULK_MAX=500
# Largest zip the gallery will bundle for a multi-select download, in MB
ZIP_MAX_MB=512
# DEBUG | INFO | WARNING — INFO records deletions and offload activity
LOG_LEVEL=INFO

MOTION_DAEMON=off
# # Level of log messages [1..9] (EMG, ALR, CRT, ERR, WRN, NTC, INF, DBG, ALL).
MOTION_LOG_LEVEL=1
# tmpfs capture buffer — NOT a permanent location, see NFS offload above
MOTION_TARGET_DIR=/run/picam/media
MOTION_WEBCONTROL_LOCALHOST=off
MOTION_WEBCONTROL_PORT=0
MOTION_STREAM_LOCALHOST=off
MOTION_STREAM_PORT=8081
#MOTION_PICTURE_OUTPUT=on
#MOTION_PICTURE_OUTPUT=off
MOTION_PICTURE_OUTPUT=first
MOTION_MOVIE_OUTPUT=off
MOTION_STREAM_MAXRATE=100
#MOTION_FRAMERATE=60
MOTION_FRAMERATE=15
MOTION_WIDTH=1280
MOTION_HEIGHT=960
MOTION_ROTATE=0
#MOTION_THRESHOLD=2000 
MOTION_THRESHOLD=2000 
MOTION_MINIMUM_MOTION_FRAMES=1
MOTION_EVENT_GAP=0
MOTION_PRE_CAPTURE=2
