# Pan/tilt startup position (-90 to 90 degrees, 0 = center)
PAN_START=55
TILT_START=80

# Basic auth — leave blank to disable (anyone on the network can access the UI)
AUTH_USER=picamera
AUTH_PASS=picamera

# Soft movement limits — camera will never move beyond these angles
# Useful when cables or mounting restrict the physical range
PAN_MIN=-90
PAN_MAX=90
TILT_MIN=-90
TILT_MAX=90

# Auto-scan sweep speed in radians/sec (0.4 ≈ 8s side-to-side, 0.2 ≈ 16s)
SCAN_SPEED=0.4

MOTION_DAEMON=off
# # Level of log messages [1..9] (EMG, ALR, CRT, ERR, WRN, NTC, INF, DBG, ALL).
MOTION_LOG_LEVEL=1
MOTION_TARGET_DIR=/var/lib/motion
MOTION_WEBCONTROL_LOCALHOST=off
MOTION_WEBCONTROL_PORT=0
MOTION_STREAM_LOCALHOST=off
MOTION_STREAM_PORT=8081
#MOTION_PICTURE_OUTPUT=on
#MOTION_PICTURE_OUTPUT=first
MOTION_PICTURE_OUTPUT=off
MOTION_MOVIE_OUTPUT=off
MOTION_STREAM_MAXRATE=100
#MOTION_FRAMERATE=60
MOTION_FRAMERATE=15
MOTION_WIDTH=1280
MOTION_HEIGHT=960
MOTION_ROTATE=0
#MOTION_THRESHOLD=2000 
MOTION_THRESHOLD=2000 
MOTION_MINIMUM_MOTION_FRAMES=1
MOTION_EVENT_GAP=0
MOTION_PRE_CAPTURE=2
